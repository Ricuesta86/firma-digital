# Configuración SMTP para el envío de la solicitud (Nodemailer)

# Host del servidor SMTP (ej. smtp.gmail.com, smtp.ionos.es, smtp.migadu.com)
SMTP_HOST=

# Puerto del servidor SMTP (587 para TLS/STARTTLS, 465 para SSL)
SMTP_PORT=587

# Usuario y contraseña. En Gmail usa una "contraseña de aplicación"
SMTP_USER=
SMTP_PASS=

# Remitente del correo (debe coincidir con la cuenta autorizada del SMTP)
SMTP_FROM=

# Destinatario de las solicitudes de firma digital
CONTACT_EMAIL=

# Base de datos del panel de administración (SQLite)
# Opcional: si no se define, se usa file:./data/app.db
# IMPORTANTE: este fichero contiene datos personales (NIF, documento de
# identidad, teléfono) sujetos al RGPD. No lo subas a ningún repositorio.
DATABASE_URL=file:./data/app.db

# Acceso al panel de administración (/admin)
# Un único administrador. Sin estas variables el panel no permite el acceso.

# Correo del administrador
ADMIN_EMAIL=

# Contraseña del administrador (usa una larga y única)
ADMIN_PASSWORD=

# Secreto con el que se firma la cookie de sesión.
# Genéralo con: openssl rand -base64 32
# Cambiarlo invalida todas las sesiones activas.
ADMIN_SESSION_SECRET=
