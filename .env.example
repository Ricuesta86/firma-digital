# Configuración SMTP para el envío de la solicitud (Nodemailer)

# Host del servidor SMTP (ej. smtp.gmail.com, smtp.ionos.es, smtp.migadu.com)
SMTP_HOST=

# Puerto del servidor SMTP (587 para TLS/STARTTLS, 465 para SSL)
SMTP_PORT=587

# Usuario y contraseña. En Gmail usa una "contraseña de aplicación"
SMTP_USER=
SMTP_PASS=

# Remitente del correo (debe coincidir con la cuenta autorizada del SMTP)
SMTP_FROM=

# Destinatario de las solicitudes de firma digital
CONTACT_EMAIL=

# Base de datos del panel de administración
#
# Hay dos destinos posibles, y solo puede estar activo uno de los dos a la vez:
# un fichero SQLite local (desarrollo) o una base de datos de Turso
# (staging/producción). Si defines los dos, la aplicación arranca con un error
# en vez de elegir uno en silencio.
#
# Opción A — SQLite local (desarrollo). Es el valor por defecto si no defines
# nada, así que normalmente no necesitas tocar esta variable.
# IMPORTANTE: este fichero contiene datos personales (NIF, documento de
# identidad, teléfono) sujetos al RGPD. No lo subas a ningún repositorio.
#   DATABASE_URL=file:./data/app.db
#
# Opción B — Turso. Define TURSO_DATABASE_URL y TURSO_AUTH_TOKEN.
# Alternativamente puedes poner la URL de Turso en DATABASE_URL, que tiene
# prioridad sobre TURSO_DATABASE_URL.
#
# La URL usa el esquema libsql:// y NUNCA lleva el token dentro.
# Crea la base de datos con `turso db create firma-digital`, y genera el token
# con `turso db tokens create --read-write`. El token necesita permisos de
# lectura y escritura: `prisma migrate deploy` no podrá aplicarlo si es de solo
# lectura.
#   TURSO_DATABASE_URL=libsql://firma-digital-<org>.turso.io
#   TURSO_AUTH_TOKEN=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Acceso al panel de administración (/admin)
# Un único administrador. Sin estas variables el panel no permite el acceso.

# Correo del administrador
ADMIN_EMAIL=

# Contraseña del administrador (usa una larga y única)
ADMIN_PASSWORD=

# Secreto con el que se firma la cookie de sesión.
# Genéralo con: openssl rand -base64 32
# Cambiarlo invalida todas las sesiones activas.
ADMIN_SESSION_SECRET=
